	instance ads-test-case01 : ADSdomain:AutomatedDrivingSystemDomain[
		ADSdomain:hasAV sv
		ADSdomain:hasJASPARODD odd-01
		base:hasDescription "Table 61. Vehicle Following Test Scenarios Straight 25, slower speed VF_S_25_Slow"
		
	]

    instance ads-system : ADSdomain:AutomatedDrivingSystem[
		ADSdomain:performs ddt:vehicle-following
	]

	instance odd-01 : ADSdomain:JASPARODD[
		ADSdomain:hasEC ClearNoon
		ADSdomain:hasEC day
		ADSdomain:hasPI dividedHighway
		ADSdomain:hasPI concreteBarriers
		ADSdomain:hasPI solidLine
		ADSdomain:hasPI curved
		ADSdomain:hasOC 60kph
		ADSdomain:hasOC 100kph
		ADSdomain:hasOC normalTraffic
		// ADSdomain:hasTP buses
		// ADSdomain:hasTP deer
		ADSdomain:hasConnectivity V2X
		ADSdomain:hasPI asphalt
		ADSdomain:hasPI trafficSignals
	    ADSdomain:hasTP pov-1
		// ADSdomain:hasTP pov-2
		// ADSdomain:hasTP pov-3
		ADSdomain:MinimumRelativeDistanceX "0.0"^^xsd:float // Example value for minimum relative distance in X
		ADSdomain:MinimumRelativeDistanceY "3.0"^^xsd:float // Example value for minimum relative distance in Y

	]
	// instance environmentalcondition1 :ADSdomain:EnverionmentalCondition[
	instance sv :ADSdomain:AutomatedVehicle[
        ADSdomain:equippes ads-system
		ADSdomain:hasPos-X sv.pos.x
		ADSdomain:hasPos-Y sv.pos.y
		ADSdomain:hasPos-Z sv.pos.z
		ADSdomain:hasVelocity sv.v
		ADSdomain:hasVehicleType sv.type
		ADSdomain:hasAcceleration sv.acc
		ADSdomain:hasOrientation sv.orientation
		ADSdomain:hasSteering sv.steering
	]
	instance sv.pos.x : ADSdomain:Pos-X[
		ADSdomain:hasFloatNumber "87.53738403320312"^^xsd:float
	]
	instance sv.pos.y : ADSdomain:Pos-Y[
		ADSdomain:hasFloatNumber "13.280508518218994"^^xsd:float
	]
	instance sv.pos.z : ADSdomain:Pos-Z[
		ADSdomain:hasFloatNumber "10.905505180358887"^^xsd:float
	]
	instance sv.v : ADSdomain:Velocity[
		ADSdomain:hasFloatNumber "29.167"^^xsd:float
	]
	instance sv.type : ADSdomain:VehicleType[
		ADSdomain:hasString "Car"
	]
	instance sv.acc : ADSdomain:Acceleration[
		ADSdomain:hasFloatNumber "0.0"^^xsd:float
	]
	instance sv.orientation : ADSdomain:Orientation[
		ADSdomain:hasFloatNumber "101.6"^^xsd:float
	]
	instance sv.steering : ADSdomain:Steering[
		ADSdomain:hasFloatNumber "0.0"^^xsd:float
	]

	instance pov-1 : RoadUser:ManualMovingVehicles[
		ADSdomain:hasPos-X pov-1.pos.x
		ADSdomain:hasPos-Y pov-1.pos.y
		ADSdomain:hasPos-Z pov-1.pos.z
		ADSdomain:hasVelocity pov-1.v
		ADSdomain:hasVehicleType pov-1.type
		ADSdomain:hasAcceleration pov-1.acc
		ADSdomain:hasOrientation pov-1.orientation
		ADSdomain:hasSteering pov-1.steering

		
	]
	instance pov-1.pos.x : ADSdomain:Pos-X[
		ADSdomain:hasFloatNumber "105.0"^^xsd:float
	]
	instance pov-1.pos.y : ADSdomain:Pos-Y[
		ADSdomain:hasFloatNumber "0.0"^^xsd:float
	]
	instance pov-1.pos.z : ADSdomain:Pos-Z[
		ADSdomain:hasFloatNumber "0.0"^^xsd:float
	]
	instance pov-1.v : ADSdomain:Velocity[
		ADSdomain:hasFloatNumber "26.667"^^xsd:float
	]
	instance pov-1.type : ADSdomain:VehicleType[
		ADSdomain:hasString "Car"
	]
	instance pov-1.acc : ADSdomain:Acceleration[
		ADSdomain:hasFloatNumber "0.0"^^xsd:float
	]
	instance pov-1.orientation : ADSdomain:Orientation[
		ADSdomain:hasFloatNumber "0.0"^^xsd:float
	]
	instance pov-1.steering : ADSdomain:Steering[
		ADSdomain:hasFloatNumber "0.0"^^xsd:float
	]
	
