	instance day : Illumination:Day
	instance dividedHighway : Road:DividedHighway
	instance concreteBarriers : RoadFurniture:ConcreteBarriers
	instance solidLine : RoadMarking:SolidLine
	instance 60kph : SpeedLimit:MinimumSpeedLimit
	instance 100kph : SpeedLimit:MaximumSpeedLimit
	instance normalTraffic : TrafficConditions:NormalTraffic
	// instance buses : RoadUser:BusesVehicleTypes
	// instance deer : NonRoadUser:DeerAnimals
	instance V2X :  Connectivity:V2XCommunicationSystem
	instance asphalt : RoadInfrastructure:AsphaltRoadSurface
	instance trafficSignals : Signage:TrafficSignals
    instance curved : RoadInfrastructure:CurvesRoadGeometry[
        RoadInfrastructure:curveRadius "500.0"^^xsd:string
    ]
