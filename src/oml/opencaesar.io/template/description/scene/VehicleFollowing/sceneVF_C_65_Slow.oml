	instance ClearNoon : Weather:ClearNoon[
		EnverionmentalCondition:weatherPattern "ClearNoon"
		// EnverionmentalCondition:cloudiness "100.0"^^xsd:float
		// EnverionmentalCondition:dust_storm "100.0"^^xsd:float
