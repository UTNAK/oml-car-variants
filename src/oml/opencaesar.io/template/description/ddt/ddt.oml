@dc:title "Example Description"
@dc:creator "Example Company"
@dc:rights "Copyright 2019, by Example Company"
description <http://opencaesar.io/template/description/ddt/ddt#> as ddt {

	uses <http://purl.org/dc/elements/1.1/> as dc

	uses <http://imce.jpl.nasa.gov/foundation/base#> as base

    uses <http://opencaesar.io/template/vocabulary/DDT/DynamicDrivingTasks#> as DDT
    uses <http://www.w3.org/2001/XMLSchema#> as xsd

    instance low-speed-merge : DDT:Low-Speed-Merge[
        base:hasDescription "ADS merges into a lane below about 45 mph, for example from an exit ramp, by identifying a vacant lane position and matching speed."
        base:hasCanonicalName "Low-Speed Merge"
        DDT:maxVelocity "12.5"^^xsd:float // 45mph->m/s
        DDT:MinimumTHW "2.0"^^xsd:float // Example value for minimum time to collision
    ]

    instance baseline : DDT:Baseline[
        base:hasDescription "ADS merges into a lane below about 45 mph, for example from an exit ramp, by identifying a vacant lane position and matching speed."
        base:hasCanonicalName "Low-Speed Merge"
        DDT:maxVelocity "12.5"^^xsd:float // 45mph->m/s
        DDT:MinimumTHW "2.0"^^xsd:float // Example value for minimum time to collision
    ]

    instance simple-positive : DDT:Simple-Positive[
        base:hasDescription "ADS merges into a lane below about 45 mph, for example from an exit ramp, by identifying a vacant lane position and matching speed."
        base:hasCanonicalName "Low-Speed Merge"
        DDT:maxVelocity "12.5"^^xsd:float // 45mph->m/s
        DDT:MinimumTHW "2.0"^^xsd:float // Example value for minimum time to collision
    ]

    instance complex-positive : DDT:Complex-Positive[
        base:hasDescription "ADS merges into a lane below about 45 mph, for example from an exit ramp, by identifying a vacant lane position and matching speed."
        base:hasCanonicalName "Low-Speed Merge"
        DDT:maxVelocity "12.5"^^xsd:float // 45mph->m/s
        DDT:MinimumTHW "2.0"^^xsd:float // Example value for minimum time to collision
    ]

    instance simple-negative : DDT:Simple-Negative[
        base:hasDescription "ADS merges into a lane below about 45 mph, for example from an exit ramp, by identifying a vacant lane position and matching speed."
        base:hasCanonicalName "Low-Speed Merge"
        DDT:maxVelocity "12.5"^^xsd:float // 45mph->m/s
        DDT:MinimumTHW "2.0"^^xsd:float // Example value for minimum time to collision
    ]

    instance parking : DDT:Parking[
        base:hasDescription "ADS comes to a complete stop within a vacant parking spot; may be further qualified by parallel or perpendicular orientations, lot type (closed/open), initiation conditions, etc."
        base:hasCanonicalName "Parking"

    ]

    instance vehicle-following : DDT:Vehicle-Following[
        base:hasDescription "ADS follows a lead vehicle in the same lane, maintaining a safe distance and speed relative to the lead vehicle."
        base:hasCanonicalName "Vehicle Following"
        DDT:maxVelocity "29.1667"^^xsd:float // 105mph->m/s
        DDT:MinimumTHW "2.0"^^xsd:float // Example value for minimum time to collision
        DDT:AcceptableFollowingDistance "SafeDistancebyMobileye"^^xsd:string // acceptable following distance calculaed using Mobileye formula
        // ddt:AcceptableFollowingDistance "100"^^xsd:float // Example value for acceptable following distance
    ]
    // instance ddt-notvalid : ddt:Low-Speed-Merge, ddt:notValidMaxVelocityOfDDT[
    //     ddt:maxVelocity "40.0"^^xsd:float
    // ]


}