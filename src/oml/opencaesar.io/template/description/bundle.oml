@dc:title "Example Description Bundle"
@dc:creator "Example Company"
@dc:rights "Copyright 2019, by Example Company"
description bundle <http://opencaesar.io/template/description/bundle#> as description-bundle {
	
	uses <http://purl.org/dc/elements/1.1/> as dc	

	uses <http://opencaesar.io/template/vocabulary/bundle#>
	
	includes <http://opencaesar.io/template/description/description1#>
	includes <http://opencaesar.io/template/description/missions#>
	includes <http://opencaesar.io/template/description/objectives#>

	includes <http://opencaesar.io/template/description/ADSdomain#>

	includes <http://opencaesar.io/template/description/scene/LowSpeedMerge/scene01#>
	includes <http://opencaesar.io/template/description/scene/LowSpeedMerge/scene02#>
    includes <http://opencaesar.io/template/description/scene/LowSpeedMerge/scene03#>
	includes <http://opencaesar.io/template/description/scene/LowSpeedMerge/scene04#>
	includes <http://opencaesar.io/template/description/scene/LowSpeedMerge/scene05#>
	includes <http://opencaesar.io/template/description/scene/LowSpeedMerge/scene06#>
	includes <http://opencaesar.io/template/description/scene/VehicleFollowing/sceneVF_S_25_Slow#>
	includes <http://opencaesar.io/template/description/scene/VehicleFollowing/sceneVF_C_65_Slow#>

}
