@dc:title "Example Vocabulary"
@dc:creator "Example Company"
@dc:rights "Copyright 2019, by Example Company"
@dc:description "ADS Tactical and Operational Maneuvers from p.13 of NHTSA A Framework for Automated Driving System Testable Cases and Scenarios.Through the literature review and analysis, a working list of tactical and operational maneuvers related to ADS driving control was created."

vocabulary <http://opencaesar.io/template/vocabulary/DDT/DynamicDrivingTasks#> as DynamicDrivingTasks {

	extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.w3.org/2000/01/rdf-schema#> as rdfs
    extends <http://www.w3.org/2001/XMLSchema#> as xsd


	extends <http://opencaesar.io/template/vocabulary/ADSdomain#> as adsdomain
    extends <http://imce.jpl.nasa.gov/foundation/mission#> as mission
    extends <http://www.w3.org/2003/11/swrlb#> as swrlb


    concept DynamicDrivingTask < mission:Objective[    
    ]

	@rdfs:label "Parking"
	@dc:description "ADS comes to a complete stop within a vacant parking spot; may be further qualified by parallel or perpendicular orientations, lot type (closed/open), initiation conditions, etc."
    concept Parking < DynamicDrivingTask

	@rdfs:label "Low-Speed Merge"
    @dc:description "ADS merges into a lane below about 45 mph, for example from an exit ramp, by identifying a vacant lane position and matching speed."
    concept Low-Speed-Merge  < DynamicDrivingTask[
        restricts maxVelocity to exactly 1
    ]
    concept Vehicle-Following  < DynamicDrivingTask[
        restricts RelativeVelocity to exactly 1
    ]

	@rdfs:label "Navigate Work Zone"
	@dc:description "ADS determines right-of-way and traffic patterns, enters, navigates and exits work zone, and communicates with other road users as necessary."
    concept Navigate-Work-Zone < DynamicDrivingTask

	@rdfs:label "N-Point Turn"
	@dc:description "ADS makes a heading adjustment that involves alternating between forward and reverse movement and adjusting steering to reposition the vehicle within a tight space."
    concept N-Point-Turn < DynamicDrivingTask

	@rdfs:label "U-Turn"
	@dc:description "ADS determines right-of-way, initiates, and completes a U-turn, and communicates with other road users as necessary."
    concept U-Turn < DynamicDrivingTask

	@rdfs:label "Route Planning"
	@dc:description "ADS uses various information to define (and potentially update) a route network including road segments, turns, etc."
    concept Route-Planning < DynamicDrivingTask



    scalar property maxVelocity[
        domain DynamicDrivingTask
        range xsd:float
        functional  
    ]

    scalar property MinimumTHW[
        domain DynamicDrivingTask
        range xsd:float
        functional
    ]

    scalar property RelativeVelocity[
        domain DynamicDrivingTask
        range xsd:float
        functional
    ]
    
    // scalar property MinimumRelativeDistanceX[
    //     domain DynamicDrivingTask
    //     range xsd:float
    //     functional
    // ]

    // scalar property MinimumRelativeDistanceY[
    //     domain DynamicDrivingTask
    //     range xsd:float
    //     functional
    // ]

    aspect NotValidVel
    // aspect NotValidRelativeDistanceX
    // aspect NotValidRelativeDistanceY

    rule low-speed-merge-velocity[
        maxVelocity(ddt, vmax) &
         adsdomain:isPerformedBy(ddt, ads) &
          adsdomain:isEquippedTo(ads, sv) & 
           adsdomain:hasVelocity(sv, vel) &
            adsdomain:hasFloatNumber(vel, value) &
             builtIn ( swrlb:lessThan, vmax, value) -> NotValidVel(vel)
    ]

    // rule RelativeDistanceX[
    //     MinimumRelativeDistanceX(ddt, minrelX) &
    //      adsdomain:isPerformedBy(ddt, ads) &
    //       adsdomain:isEquippedTo(ads, sv) &
    //        adsdomain:isAVOf(sv, av) &
    //         adsdomain:hasJASPARODD(av, odd) &
    //          adsdomain:hasTP(odd, tp) &
    //           adsdomain:hasPos-X(tp, posX) &
    //            adsdomain:hasFloatNumber(posX, value) &
    //             builtIn ( swrlb:lessThan, value, minrelX) -> NotValidRelativeDistanceX(posX)
    // ]

    // rule RelativeDistanceY[
    //     MinimumRelativeDistanceY(ddt, minrelY) &
    //      adsdomain:isPerformedBy(ddt, ads) &
    //       adsdomain:isEquippedTo(ads, sv) &
    //        adsdomain:isAVOf(sv, av) &
    //         adsdomain:hasJASPARODD(av, odd) &
    //          adsdomain:hasTP(odd, tp) &
    //           adsdomain:hasPos-Y(tp, posY) &
    //            adsdomain:hasFloatNumber(posY, value) &
    //             builtIn ( swrlb:lessThan, value, minrelY) -> NotValidRelativeDistanceY(posY)
    // ]

    


    @rdfs:label "Navigate-Roundabouts"
    @dc:description " ADS determines right-of-way, enters, navigates, and exits a 
     roundabout, and communicates with other road users as necessary. "
    concept Navigate-Roundabouts  < DynamicDrivingTask[
        //restricts maxVelocity to exactly 1
    ]

    @rdfs:label "Navigate-Intersection"
    @dc:description "  ADS determines right-of-way, enters, navigates, and exits 
     intersections, including signalized, stop signs, 4/3/2-ways, and communicates with 
     other road users as necessary; may include left or right turns across oncoming traffic.  "
    concept Navigate-Intersection  < DynamicDrivingTask[
        //restricts maxVelocity to exactly 1
    ]

    @rdfs:label "Navigate-Crosswalk"
    @dc:description "  ADS determines right-of-way, enters, navigates, and exits 
     pedestrian crosswalks, and communicates with other road users as necessary. "
    concept Navigate-Crosswalk  < DynamicDrivingTask[
        //restricts maxVelocity to exactly 1
    ]


}